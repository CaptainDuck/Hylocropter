[Unit]
Description=Hylocropter: own Wi-Fi hotspot when no known network is reachable
After=NetworkManager.service hylocropter-wifi.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/hylocropter-wifi watch
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
